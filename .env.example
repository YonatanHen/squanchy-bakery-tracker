# Settings for Docker Compose and the backend. Copy to .env and fill in the empty values.

# Database: Docker Compose creates it with these values
POSTGRES_USER=squanchy
POSTGRES_PASSWORD=squanchy
POSTGRES_DB=squanchy_bakery
POSTGRES_TEST_DB=squanchy_bakery_test

# Backend database URLs, built from the values above (change host/port for your own server)
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
TEST_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_TEST_DB}

# Must have a value; an empty secret makes login fail
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_MINUTES=480

# The admin user the seed creates on first start
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password

LOG_LEVEL=INFO
