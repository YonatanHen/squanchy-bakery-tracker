# Copy to backend/.env and fill in. The DB user/password match docker-compose.yml.
DATABASE_URL=postgresql+psycopg://squanchy:squanchy@localhost:5432/squanchy_bakery
TEST_DATABASE_URL=postgresql+psycopg://squanchy:squanchy@localhost:5432/squanchy_bakery_test
# At least 32 bytes, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRES_MINUTES=480
LOG_LEVEL=INFO
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
